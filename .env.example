# APIWise Environment Configuration
# Copy this file to .env and configure values for your deployment

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apiwise
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Environment Variable Encryption Key (AES-256)
ENCRYPTION_KEY=ApiWiseSecretEncKeyForEnvVars2026!

# SSRF and Network Security
ALLOW_LOOPBACK_REQUESTS=false

# Optional AI Assistant Integration (OpenAI or compatible provider)
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Frontend Port
FRONTEND_PORT=3000
# Backend Port
BACKEND_PORT=8080
